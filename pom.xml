<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Echtes Maven-Elternprojekt (PLANUNG.md Abschnitt 5: "pom.xml #
        Maven-Elternprojekt"), nicht nur ein Aggregator. chat-service und
        batch-writer erben von hier ihr Dependency-Management (transitiv
        ueber spring-boot-starter-parent). api-gateway und user-service
        sind absichtlich NICHT Teil dieses Builds - sie gehoeren nicht zum
        Umfang dieser Abgabe und sollen den Build von Szenario S1 nicht
        gefaehrden koennen, ohne etwas beizutragen (siehe
        docs/spec-batch-writer.md, Abschnitt 7). Ihr Code bleibt im Repo
        bestehen, nur ausserhalb dieses Reactor-Builds.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>ch.m321.chatapp</groupId>
    <artifactId>chat-app-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>chat-app-parent</name>
    <description>Maven-Elternprojekt der M321 Chat-App (Abgabe batch-writer).</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <modules>
        <module>backend/chat-service</module>
        <module>backend/batch-writer</module>
    </modules>

</project>
