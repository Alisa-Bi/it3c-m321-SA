# Beispielwerte fuer die lokale Entwicklung. Echte Passwoerter gehoeren NIE
# ins Repository - nur in eine lokale .env (siehe .gitignore).
#
# Direkt die von docker-compose.yml/postgres erwarteten Variablennamen,
# keine Umbenennung dazwischen (siehe docs/spec-batch-writer.md, Abschnitt 4.2).

POSTGRES_USER=chatapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat

RABBITMQ_DEFAULT_USER=chatapp
RABBITMQ_DEFAULT_PASS=change-me

# Live-Zustellung (siehe docs/spec-live-zustellung.md, Abschnitt 7).
# Maximale Groesse des Nachrichteninhalts in UTF-8-Bytes.
CHAT_MAX_CONTENT_BYTES=4096
# Lebensdauer einer SSE-Verbindung in Millisekunden.
CHAT_SSE_TIMEOUT=1800000
# Abstand zwischen zwei SSE-Heartbeats (Dauer, z. B. 15s).
CHAT_SSE_HEARTBEAT_INTERVAL=15s
# Unbestaetigte Nachrichten pro Consumer der Zustell-Queue.
CHAT_DELIVERY_PREFETCH=10
# Obergrenze der bereitliegenden Nachrichten in der Zustell-Queue je Instanz.
CHAT_DELIVERY_QUEUE_MAX_LENGTH=990
